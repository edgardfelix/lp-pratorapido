# Copy to client/.env (values are public: they end up in the built page).

# Canonical public origin, used for absolute share URLs and the canonical link.
VITE_SITE_URL=https://pratorapido.com.br

# Optional: where buyers open the app after confirming access (https).
VITE_APP_URL=

# Optional: API base path or origin (defaults to same-origin /api).
VITE_API_BASE=/api
