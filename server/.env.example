# ---------------------------------------------------------------------------
# Prato Rápido · integration server
# Copy to server/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

# Public origin of the landing page (used to check the Origin of API calls).
PUBLIC_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of this server (0 locally, 1 behind a
# load balancer / Nginx / Cloudflare). Needed for correct client IPs.
TRUST_PROXY=0

# --- Cakto webhook --------------------------------------------------------
# The "secret" of the webhook created in the Cakto panel (Integrações → Webhooks).
# Point the webhook to:  https://<your-domain>/api/webhooks/cakto
CAKTO_WEBHOOK_SECRET=
# Reject deliveries without the X-Cakto-Signature header (recommended in production).
CAKTO_REQUIRE_SIGNATURE=true
# Optional: only these product ids / short ids grant access (comma-separated).
CAKTO_PRODUCT_IDS=

# --- Access tokens and verification codes ---------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
# Where buyers open the app after confirming access (https only, optional).
APP_URL=

# --- E-mail (SMTP) ---------------------------------------------------------
# Without SMTP, codes are printed to the console in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prato Rápido <nao-responda@seu-dominio.com.br>"

# --- Storage and static files ---------------------------------------------
DATA_DIR=./data
STATIC_DIR=../client/dist
